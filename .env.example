# ─────────────────────────────────────────────────────
# TokenTalks Phase 1 Environment Variables
# Copy to .env.local and fill in values
# ─────────────────────────────────────────────────────

# Database (Neon)
DATABASE_URL=postgresql://user:password@host.neon.tech/tokentalks?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host.neon.tech/tokentalks?sslmode=require

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Inngest
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# GitHub (personal access token, classic, public_repo + read:org scope)
GITHUB_TOKEN=ghp_your_token_here

# Sentry
SENTRY_DSN=https://key@sentry.io/project-id
SENTRY_ENVIRONMENT=development

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
