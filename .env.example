# ─────────────────────────────────────────────────────
# TokenTalks Environment Variables
# Copy to .env.local and fill in values
# ─────────────────────────────────────────────────────

# Database (Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/tokentalks?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-secret"

# Auth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""

# LinkedIn (optional — uncomment in src/lib/auth.ts when ready)
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""

# Enrichment (M5)
GEMINI_API_KEY=""

# Ingestion Jobs (M4)
CRON_SECRET="my-super-secret-cron-token"
