generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_URL_UNPOOLED")
  extensions = [pgvector(map: "vector")]
}

enum SourceType {
  github_release
  github_advisory
  rss
  arxiv
  hackernews
  osv
}

enum Category {
  AI
  DevOps
  Cloud
  Web
  Backend
  Data
  Mobile
  Security
  OpenSource
  Tools
  Research
}

enum ImpactLabel {
  BreakingChange
  NewCapability
  SecurityFix
  CostChange
  PerformanceImprovement
  DeveloperExperience
  Deprecation
  Silent
}

enum Importance {
  Critical
  Severe
  Important
  Normal
  Low
}

enum SignalStatus {
  draft
  published
  archived
}

model RawEvent {
  id         String     @id @default(cuid())
  sourceType SourceType
  sourceKey  String
  sourceUrl  String
  sourceId   String?
  payload    Json
  hash       String     @unique
  fetchedAt  DateTime   @default(now())

  signals Signal[]

  @@index([sourceType, fetchedAt])
  @@index([sourceKey, fetchedAt])
}

model Signal {
  id               String      @id @default(cuid())
  slug             String      @unique
  title            String
  mnemonicLabel    String
  quickHitSummary  String
  summary          String
  whyItMatters     String
  whoShouldCare    String
  category         Category
  impactLabel      ImpactLabel
  impactConfidence Float       @default(0.5)
  importance       Importance
  entities         String[]    @default([])
  sourceType       SourceType
  sourceName       String
  sourceUrl        String
  publishedAt      DateTime
  fetchedAt        DateTime    @default(now())
  rawEventId       String?
  rawEvent         RawEvent?   @relation(fields: [rawEventId], references: [id])
  status           SignalStatus @default(published)
  createdAt        DateTime    @default(now())
  canonicalKey     String      @unique

  @@index([status, publishedAt(sort: Desc)])
  @@index([category, publishedAt(sort: Desc)])
  @@index([impactLabel, publishedAt(sort: Desc)])
  @@index([importance, publishedAt(sort: Desc)])
  @@index([entities], type: Gin)
}

model SourceHealth {
  id                   String     @id @default(cuid())
  sourceKey            String     @unique
  sourceType           SourceType
  enabled              Boolean    @default(true)
  lastSuccessAt        DateTime?
  lastErrorAt          DateTime?
  lastError            String?
  consecutiveFailures  Int        @default(0)
  totalFetches         Int        @default(0)
  totalSignalsProduced Int        @default(0)
  updatedAt            DateTime   @updatedAt

  @@index([enabled])
}

model FeedMeta {
  id                      Int       @id @default(1)
  tokenStreamLastFlowedAt DateTime?
  ingestionLastRunAt      DateTime?
  totalSignalsPublished   Int       @default(0)
  updatedAt               DateTime  @updatedAt
}
