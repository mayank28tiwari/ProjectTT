      "namedRegex": "^/api/extract(?:/)?$"
    },
    {
      "page": "/api/follows",
      "regex": "^/api/follows(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/follows(?:/)?$"
    },
    {
      "page": "/api/jobs/run",
      "regex": "^/api/jobs/run(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/jobs/run(?:/)?$"
    },
    {
      "page": "/api/me",
      "regex": "^/api/me(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/me(?:/)?$"
    },
    {
      "page": "/api/meta",
      "regex": "^/api/meta(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/meta(?:/)?$"
    },
    {
      "page": "/api/my-signals",
      "regex": "^/api/my\\-signals(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/my\\-signals(?:/)?$"
    },
    {
      "page": "/api/saved/toggle",
      "regex": "^/api/saved/toggle(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/saved/toggle(?:/)?$"
    },
    {
      "page": "/api/share/tweet",
